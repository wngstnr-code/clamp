{
  "name": "@clamp/backend",
  "version": "0.1.0",
  "description": "Clamp worker: price reporter, record step, cranks and the bill proxy",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @clamp/sdk build && tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "tick": "tsx --env-file=../.env src/cli.ts tick",
    "report": "tsx --env-file=../.env src/cli.ts report",
    "record": "tsx --env-file=../.env src/cli.ts record",
    "dry-run": "tsx --env-file=../.env src/cli.ts report --dry-run",
    "setup:devnet": "tsx --env-file=../.env src/setup-devnet.ts",
    "verify": "tsx --env-file=../.env src/cli.ts verify",
    "bundle:reporter": "pnpm --filter @clamp/sdk build && esbuild src/reporter-cli.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/reporter.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --log-level=warning"
  },
  "dependencies": {
    "@clamp/sdk": "workspace:*",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "@supabase/supabase-js": "2.119.0",
    "hono": "4.13.16"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "24.x"
  }
}
