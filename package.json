{
  "name": "clamp",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check:dashes": "node scripts/check-dashes.mjs",
    "idl:sync": "cp target/idl/clamp.json target/idl/test_usdc.json packages/sdk/src/idl/ && cp target/types/clamp.ts target/types/test_usdc.ts packages/sdk/src/idl/",
    "test:sdk": "pnpm --filter @clamp/sdk test",
    "build:sdk": "pnpm --filter @clamp/sdk build"
  },
  "devDependencies": {
    "supabase": "3.2.0"
  },
  "pnpm": {
    "overrides": {
      "rpc-websockets": "9.3.10"
    }
  }
}
