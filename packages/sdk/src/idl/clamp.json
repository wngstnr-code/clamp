  "types": [
    {
      "name": "ClassConfig",
      "docs": [
        "Settings of one GPU class. PDA `[\"class\", class_id]`.",
        "",
        "Reporters, quorum, bounds and widths affect future updates and future",
        "series only. The sources are fixed when the class is created, because the",
        "stored reports are read by source slot."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "class_id",
            "docs": [
              "1 = RTX 4090, 2 = H100. 0 means the account was just created."
            ],
            "type": "u8"
          },
          {
            "name": "name",
            "type": {
              "array": [
                "u8",
                16
              ]
            }
          },
          {
            "name": "enabled",
            "type": "bool"
          },
          {
            "name": "reporters",
            "type": {
              "array": [
                "pubkey",
                5
              ]
            }
          },
          {
            "name": "reporter_count",
            "type": "u8"
          },
          {
            "name": "min_reporters",
            "type": "u8"
          },
          {
            "name": "sources",
            "type": {
              "array": [
                {
                  "defined": {
                    "name": "Source"
                  }
                },
                6
              ]
            }
          },
          {
            "name": "source_count",
            "type": "u8"
          },
          {
            "name": "min_sources",
            "type": "u8"
          },
          {
            "name": "min_total_weight",
            "type": "u8"
          },
          {
            "name": "min_price",
            "docs": [
              "Sanity bounds for one reported price, micro-USD per GPU-hour."
            ],
            "type": "u64"
          },
          {
            "name": "max_price",
            "type": "u64"
          },
          {
            "name": "max_step_ppm",
            "type": "u32"
          },
          {
            "name": "half_width_ppm",
            "docs": [
              "Band half width per series kind: daily, weekly, monthly."
            ],
            "type": {
              "array": [
                "u32",
                3
              ]
            }
          },
          {
            "name": "current_series",
            "docs": [
              "The latest series per kind (set from M2 on)."
